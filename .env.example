# ---- Server ----
PORT=3000
# Login for the website (in-page login form). Leave both empty to disable login (NOT recommended online)
ADMIN_USER=admin
ADMIN_PASS=change-me
# Random long string used to sign login sessions (optional – derived automatically if empty)
SESSION_SECRET=
# Secret key for the cron URL: /cron/run?key=CRON_KEY
CRON_KEY=put-a-long-random-string-here
INTERNAL_WORKER=1

# ---- Database ----
# auto (default): MySQL if the MySQL values below are filled in AND reachable, otherwise SQLite
DB_CLIENT=auto
# SQLite file. Empty = Desktop/version-extractor.sqlite (server without Desktop: ./data/version-extractor.sqlite)
SQLITE_PATH=
# MySQL – leave empty to use SQLite
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# DATABASE_URL=mysql://user:pass@host:3306/dbname

# ---- OpenAI (can also be set in Settings) ----
OPENAI_API_KEY=
